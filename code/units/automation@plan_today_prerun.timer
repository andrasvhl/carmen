[Unit]
Description=Schedule for automation job plan_today_prerun

[Timer]
# Done by about 08:10 so the morning check-in opens instantly (owner decision, 2026-10-05;
# moved from 07:00 to 08:00 on 2026-10-06).
# Pacific, explicitly: the box runs on UTC. After session_log's 04:30 run.
OnCalendar=*-*-* 08:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=60
Unit=automation@plan_today_prerun.service

[Install]
WantedBy=timers.target
