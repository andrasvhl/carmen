[Unit]
Description=Schedule for automation job wiki

[Timer]
# Daily, after heartbeat (07:30) and before status (07:50), so a drifted source
# reaches the same morning's maintenance-status page rather than tomorrow's.
# The delay ceiling matters here: 07:40 + 120s still lands before the join.
OnCalendar=*-*-* 07:40:00
Persistent=true
RandomizedDelaySec=120
Unit=automation@wiki.service

[Install]
WantedBy=timers.target
